{
  "manifest_version": 3,
  "name": "Aura - Painel do fã",
  "version": "1.3.0",
  "description": "Mostra ao lado do chat a ficha do fã que você abriu. Só lê a conversa aberta. Nunca envia nada.",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://ndtnwukltujxzkfvqxtk.supabase.co/*"
  ],
  "action": {
    "default_title": "Abrir o painel do fã",
    "default_icon": {
      "16": "icone16.png",
      "32": "icone32.png"
    }
  },
  "side_panel": {
    "default_path": "painel.html"
  },
  "background": {
    "service_worker": "fundo.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://privacy.com.br/chat*"
      ],
      "js": [
        "leitor.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icone16.png",
    "32": "icone32.png",
    "48": "icone48.png",
    "128": "icone128.png"
  }
}